# Copy to .env (never commit .env).

# --- Secrets ---
SHOPIFY_STORE=your-store.myshopify.com
# Admin API token with read/write content
SHOPIFY_ADMIN_TOKEN=
# Needed by the fixer to suggest replacements
ANTHROPIC_API_KEY=

# --- Configuration ---
SHOPIFY_BLOG_ID=
SHOPIFY_BLOG_HANDLE=news
# Public site URL, used to tell internal links from external ones
SITE_URL=https://www.acmesupply.example
# Client name sent with every link check
CLIENT_ID=link-audit/1.0
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CONFIG_DIR=./config
# OUTPUT_DIR=./output
